<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Prescriptions">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFEEF3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Pill Point Delivery"
                android:textColor="@color/dark_blue"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Profile"
                android:src="@drawable/photo" />
        </LinearLayout>

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescriptions"
            android:textColor="@color/dark_blue"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Form Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <!-- Row 1: Patient Name & Doctor's Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:text="Patient Name"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etPatientName"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Enter Patient Name"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:inputType="textPersonName"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:text="Doctor's Name"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etDoctorName"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Enter Doctor's Name"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:inputType="textPersonName"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Prescription Number -->
            <TextView
                android:text="Prescription Number"
                android:textColor="@color/dark_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/etPrescriptionNumber"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/edit_text_background"
                android:hint="Prescription Number"
                android:padding="8dp"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"
                android:inputType="text"/>

            <!-- Row 2: Prescription Date & Delivery Method -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:text="Prescription Date"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etPrescriptionDate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="dd/mm/yyyy"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:inputType="date"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:text="Delivery Method"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerDeliveryMethod"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/edit_text_background"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Upload File & Additional Notes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:text="Upload Prescription (PDF, JPG, PNG)"
                        android:textColor="@color/dark_blue"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <Button
                        android:id="@+id/btnChooseFile"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:backgroundTint="@android:color/darker_gray"
                        android:text="Choose file"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:text="Additional Notes"
                        android:textColor="@color/dark_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etAdditionalNotes"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/edit_text_background"
                        android:hint="Enter special instructions"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:gravity="top"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Upload Action Button -->
            <Button
                android:id="@+id/btnSubmitPrescription"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/dark_blue"
                android:text="Upload Prescription"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Uploaded Prescriptions Section Title -->
            <TextView
                android:text="Your Uploaded Prescriptions"
                android:textColor="@color/dark_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <!-- Table Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/dark_blue"
                android:orientation="horizontal"
                android:padding="6dp"
                android:weightSum="6">
                <TextView android:text="Patient" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
                <TextView android:text="Doctor" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
                <TextView android:text="Method" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
                <TextView android:text="Date" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
                <TextView android:text="Status" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
                <TextView android:text="File" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"/>
            </LinearLayout>

            <!-- Empty State / Data Row Container -->
            <TextView
                android:id="@+id/tvNoPrescriptions"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="No uploaded prescriptions found."
                android:textColor="#555555"
                android:textSize="11sp"
                android:background="@android:color/white"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>

<com.google.android.material.navigation.NavigationView
    android:id="@+id/navView"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@android:color/white"
    app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>