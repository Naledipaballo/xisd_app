<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFEEF3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#003049"
            android:text="← Back"
            android:textColor="#FFFFFF" />

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Track Your Order"
            android:textColor="#003049"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your order ID to view the latest delivery status."
            android:textColor="#444444"
            android:textSize="14sp" />

        <!-- Order ID input -->
        <EditText
            android:id="@+id/orderNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@android:drawable/edit_text"
            android:hint="Enter Order ID"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="#003049"
            android:textColorHint="#777777" />

        <!-- Track button -->
        <Button
            android:id="@+id/trackOrderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#003049"
            android:text="Track Order"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Order details container -->
        <LinearLayout
            android:id="@+id/orderDetailsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <!-- Order information heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Information"
                android:textColor="#003049"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Order status -->
            <TextView
                android:id="@+id/orderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Status: Pending"
                android:textColor="#003049"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Order date -->
            <TextView
                android:id="@+id/orderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Order Date:"
                android:textColor="#444444"
                android:textSize="14sp" />

            <!-- Delivery address -->
            <TextView
                android:id="@+id/deliveryAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="#F5F8FA"
                android:text="Delivery Address:"
                android:textColor="#444444"
                android:textSize="14sp" />

            <!-- Selected pharmacy section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#DFEEF3"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected Pharmacy"
                    android:textColor="#003049"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pharmacyDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Pharmacy details will appear here."
                    android:textColor="#444444"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Estimated delivery -->
            <TextView
                android:id="@+id/estimatedDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Estimated Delivery:"
                android:textColor="#444444"
                android:textSize="14sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="#DDDDDD" />

            <!-- Delivery progress heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery Progress"
                android:textColor="#003049"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Order placed -->
            <TextView
                android:id="@+id/progressPlaced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="○ Order Placed"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- Order confirmed -->
            <TextView
                android:id="@+id/progressConfirmed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="○ Order Confirmed"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- Pharmacy preparing -->
            <TextView
                android:id="@+id/progressPreparing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="○ Pharmacy Preparing Order"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- Out for delivery -->
            <TextView
                android:id="@+id/progressDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="○ Out for Delivery"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- Delivered -->
            <TextView
                android:id="@+id/progressDelivered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="○ Delivered"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="#DDDDDD" />

            <!-- Order items heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Items"
                android:textColor="#003049"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Order items and payment summary -->
            <TextView
                android:id="@+id/orderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="5dp"
                android:text="Your order items will appear here."
                android:textColor="#444444"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>