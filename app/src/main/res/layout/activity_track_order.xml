<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFEEF3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#003049"
            android:text="← Back"
            android:textColor="#FFFFFF" />

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Track Order"
            android:textColor="#003049"
            android:textSize="28sp"
            android:textStyle="bold" />

    <!-- Form Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Enter your order ID to view your order status and delivery details."
            android:textColor="#444444"
            android:textSize="15sp" />

        <!-- Order ID input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Order ID"
            android:textColor="#003049"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/orderNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#003049"
            android:hint="Enter your Firestore order ID"
            android:inputType="text"
            android:minHeight="52dp"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#003049"
            android:textColorHint="#777777" />

        <!-- Track button -->
        <Button
            android:id="@+id/trackOrderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/dark_blue"
            android:text="Track Order"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Order details -->
        <LinearLayout
            android:id="@+id/orderDetailsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:visibility="gone">

            <!-- Status heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Order Details"
                android:textColor="#003049"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Current status -->
            <TextView
                android:id="@+id/orderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:background="#DFEEF3"
                android:text="Status: Pending"
                android:textColor="#003049"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Order date -->
            <TextView
                android:id="@+id/orderDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Order Date:"
                android:textColor="#444444"
                android:textSize="15sp" />

            <!-- Delivery address -->
            <TextView
                android:id="@+id/deliveryAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Delivery Address:"
                android:textColor="#444444"
                android:textSize="15sp" />

            <!-- Estimated delivery -->
            <TextView
                android:id="@+id/estimatedDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Estimated Delivery: To be confirmed"
                android:textColor="#444444"
                android:textSize="15sp" />

            <!-- Delivery progress heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Delivery Progress"
                android:textColor="#003049"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- These labels are updated by TrackOrder.kt -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="10dp"
                android:text="○ Order Placed"
                android:textColor="#444444"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="10dp"
                android:text="○ Order Confirmed"
                android:textColor="#444444"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="10dp"
                android:text="○ Pharmacy Preparing Order"
                android:textColor="#444444"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:padding="10dp"
                android:text="○ Out for Delivery"
                android:textColor="#444444"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="10dp"
                android:text="○ Delivered"
                android:textColor="#444444"
                android:textSize="15sp" />

            <!-- Ordered products and totals -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Products and Payment"
                android:textColor="#003049"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F3F7F9"
                android:padding="12dp"
                android:text="Your ordered products will appear here."
                android:textColor="#444444"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>

</ScrollView>